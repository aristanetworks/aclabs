{# Keep the lab hostname, router ID, BGP password, and BFD settings explicit. #}
{# All border addresses, interface mappings, ASNs, and loopbacks come from AVD. #}
! Generated from the four border-leaf structured configurations. Do not edit.
frr defaults traditional
hostname frr-core1
log stdout informational
service integrated-vtysh-config
!
{% for border in border_configs %}
{% set dci = border.ethernet_interfaces | selectattr('metadata.peer', 'defined') | selectattr('metadata.peer', 'equalto', 'frr-core1') | first %}
interface {{ dci.metadata.peer_interface }}
 description {{ border.hostname }}_{{ dci.name }}
{# FRR uses the other address in the border's /31 subnet. #}
 ip address {{ dci.ip_address | ansible.utils.ipaddr('peer') }}/{{ dci.ip_address.split('/')[1] }}
 ip mtu {{ dci.mtu }}
 no shutdown
exit
!
{% endfor %}
{# The shared VTEP loopbacks only need one entry in the outbound filter. #}
{% set loopbacks = border_configs | map(attribute='loopback_interfaces') | flatten | selectattr('name', 'in', ['Loopback0', 'Loopback1']) | map(attribute='ip_address') | unique | list %}
{% for prefix in loopbacks %}
ip prefix-list DCI-OUT seq {{ loop.index * 10 }} permit {{ prefix }}
{% endfor %}
!
{% for border in border_configs %}
{% for loopback in border.loopback_interfaces | selectattr('name', 'in', ['Loopback0', 'Loopback1']) %}
ip prefix-list FROM-{{ border.hostname }} seq {{ loop.index * 10 }} permit {{ loopback.ip_address }}
{% endfor %}
route-map FROM-{{ border.hostname }} permit 10
 match ip address prefix-list FROM-{{ border.hostname }}
exit
!
{% endfor %}
route-map DCI-OUT permit 10
 match ip address prefix-list DCI-OUT
exit
!
{# A border's remote AS is FRR's local AS. #}
{% set frr_neighbor = border_configs[0].router_bgp.neighbors | selectattr('metadata.peer', 'defined') | selectattr('metadata.peer', 'equalto', 'frr-core1') | first %}
router bgp {{ frr_neighbor.remote_as }}
 bgp router-id 192.168.0.250
 no bgp default ipv4-unicast
{% for border in border_configs %}
{% set dci = border.ethernet_interfaces | selectattr('metadata.peer', 'defined') | selectattr('metadata.peer', 'equalto', 'frr-core1') | first %}
{% set border_ip = dci.ip_address.split('/')[0] %}
 neighbor {{ border_ip }} remote-as {{ border.router_bgp.as }}
 neighbor {{ border_ip }} description {{ border.hostname }}
 neighbor {{ border_ip }} password arista
 neighbor {{ border_ip }} bfd
{% endfor %}
 !
 address-family ipv4 unicast
{% for border in border_configs %}
{% set dci = border.ethernet_interfaces | selectattr('metadata.peer', 'defined') | selectattr('metadata.peer', 'equalto', 'frr-core1') | first %}
{% set border_ip = dci.ip_address.split('/')[0] %}
  neighbor {{ border_ip }} activate
  neighbor {{ border_ip }} route-map FROM-{{ border.hostname }} in
  neighbor {{ border_ip }} route-map DCI-OUT out
{% endfor %}
  maximum-paths 2
 exit-address-family
exit
!
bfd
{% for border in border_configs %}
{% set dci = border.ethernet_interfaces | selectattr('metadata.peer', 'defined') | selectattr('metadata.peer', 'equalto', 'frr-core1') | first %}
 peer {{ dci.ip_address.split('/')[0] }} local-address {{ dci.ip_address | ansible.utils.ipaddr('peer') }} interface {{ dci.metadata.peer_interface }}
 exit
{% endfor %}
exit
!
