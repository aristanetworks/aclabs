! Generated from AVD structured configurations. Edit AVD inputs, then rebuild.
frr defaults traditional
hostname {{ frr_node }}
log stdout informational
service integrated-vtysh-config
!
{% for peer in frr_peers %}
interface {{ peer.interface }}
 description {{ peer.name }}_{{ peer.eos_interface }}
 ip address {{ peer.address }}
 ip mtu {{ peer.mtu }}
 no shutdown
exit
!
{% endfor %}
{% for prefix in frr_prefixes %}
ip prefix-list DCI-OUT seq {{ loop.index * 10 }} permit {{ prefix }}
{% endfor %}
!
{% for peer in frr_peers %}
{% for prefix in peer.prefixes %}
ip prefix-list FROM-{{ peer.name }} seq {{ loop.index * 10 }} permit {{ prefix }}
{% endfor %}
route-map FROM-{{ peer.name }} permit 10
 match ip address prefix-list FROM-{{ peer.name }}
exit
!
{% endfor %}
route-map DCI-OUT permit 10
 match ip address prefix-list DCI-OUT
exit
!
router bgp {{ frr_asn }}
 bgp router-id {{ frr_topology.topology.nodes[frr_node]['mgmt-ipv4'] }}
 no bgp default ipv4-unicast
{% for peer in frr_peers %}
 neighbor {{ peer.neighbor }} remote-as {{ peer.remote_as }}
 neighbor {{ peer.neighbor }} description {{ peer.name }}
{% if peer.password %}
 neighbor {{ peer.neighbor }} password {{ peer.password }}
{% endif %}
{% if peer.bfd %}
 neighbor {{ peer.neighbor }} bfd
{% endif %}
{% endfor %}
 !
 address-family ipv4 unicast
{% for peer in frr_peers %}
  neighbor {{ peer.neighbor }} activate
  neighbor {{ peer.neighbor }} route-map FROM-{{ peer.name }} in
  neighbor {{ peer.neighbor }} route-map DCI-OUT out
{% endfor %}
  maximum-paths 2
 exit-address-family
exit
!
{% if frr_peers | selectattr('bfd') | list %}
bfd
{% for peer in frr_peers if peer.bfd %}
 peer {{ peer.neighbor }} local-address {{ peer.address.split('/')[0] }} interface {{ peer.interface }}
 exit
{% endfor %}
exit
!
{% endif %}
