{
    "image": "ghcr.io/${localEnv:GITHUB_REPOSITORY}/lab-base:python3.12-avd-v6.5.0-clab0.83.0-rev2.7.2",
    // containerEnv set the variables applied to entire container
    "containerEnv": {
        "ARISTA_TOKEN": "${localEnv:ARTOKEN}",
        "CEOS_LAB_VERSION": "4.36.2F",
        "CONTAINERWSF": "${containerWorkspaceFolder}",
        "GITHUB_REPOSITORY": "${localEnv:GITHUB_REPOSITORY}",
        "PASSWORD": "${localEnv:CODER_PASSWORD}",
        "CVURL": "192.168.100.5",
        "CV_VERSION": "2026.1.0",
        "GIT_INIT": "false"
    },
    "secrets": {
        "ARTOKEN": {
            "description": "token to auto-download EOS images from arista.com."
            // "documentationUrl": "https://example.com/link/to/info"
        }
    },
    "hostRequirements": {
        "cpus": 16,
        "memory": "64gb",
        "storage": "128gb"
    },
    "onCreateCommand": "chmod +x /atd-automation-l3ls-dual-dc-cvp/addAliases.sh; /atd-automation-l3ls-dual-dc-cvp/addAliases.sh; ssh-keygen -N \"\" -f /home/avd/.ssh/id_rsa",
    "postCreateCommand": "/bin/entrypoint",
    "workspaceMount": "source=${localWorkspaceFolder}/labs/${containerWorkspaceFolder},target=/${containerWorkspaceFolder},type=bind",
    "workspaceFolder": "/atd-automation-l3ls-dual-dc-cvp",
    "containerUser": "avd",
    "customizations": {
        "aristaLabs": {
            "copyOnCreate": ["arista-avd-yaml-0.0.9.vsix"]
        }
    }
}
