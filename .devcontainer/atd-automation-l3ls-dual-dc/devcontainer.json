{
    "image": "ghcr.io/${localEnv:GITHUB_REPOSITORY}/lab-base:python3.12-avd-v6.3.0-clab0.78.1-rev2.6.10",
    // containerEnv set the variables applied to entire container
    "containerEnv": {
        "ARISTA_TOKEN": "${localEnv:ARTOKEN}",
        "CEOS_LAB_VERSION": "4.36.2F",
        "CONTAINERWSF": "${containerWorkspaceFolder}",
        "GITHUB_REPOSITORY": "${localEnv:GITHUB_REPOSITORY}",
        "LABPASSPHRASE": "arista",
        "GIT_INIT": "false"
    },
    "secrets": {
        "ARTOKEN": {
            "description": "token to auto-download EOS images from arista.com."
            // "documentationUrl": "https://example.com/link/to/info"
        }
    },
    "hostRequirements": {
        "cpus": 16,
        "memory": "64gb",
        "storage": "128gb"
    },
    "onCreateCommand": "chmod +x /atd-automation-l3ls-dual-dc/addAliases.sh; /atd-automation-l3ls-dual-dc/addAliases.sh; ssh-keygen -N \"\" -f /home/avd/.ssh/id_rsa",
    "postCreateCommand": "/bin/entrypoint",
    "workspaceMount": "source=${localWorkspaceFolder}/labs/${containerWorkspaceFolder},target=/${containerWorkspaceFolder},type=bind",
    "workspaceFolder": "/atd-automation-l3ls-dual-dc",
    "containerUser": "avd",
    "runArgs": ["--env-file", "${localWorkspaceFolder}/labs/${containerWorkspaceFolder}/.vscode/lab_vars.public.env"]
}