{
    "image": "ghcr.io/${localEnv:GITHUB_REPOSITORY}/lab-base:python3.12-avd-v6.3.0-clab0.78.1-rev2.6.10",
    "containerEnv": {
        "ARISTA_TOKEN": "${localEnv:ARTOKEN}",
        "CEOS_LAB_VERSION": "4.33.0F",
        "CONTAINERWSF": "${containerWorkspaceFolder}",
        "GITHUB_REPOSITORY": "${localEnv:GITHUB_REPOSITORY}",
        "PASSWORD": "${localEnv:CODER_PASSWORD}"
    },
    "secrets": {
        "ARTOKEN": {
            "description": "Token used to download the cEOS image from arista.com."
        }
    },
    "hostRequirements": {
        "cpus": 8,
        "memory": "16gb",
        "storage": "32gb"
    },
    "postCreateCommand": "/bin/entrypoint",
    "workspaceMount": "source=${localWorkspaceFolder}/labs/${containerWorkspaceFolder},target=/${containerWorkspaceFolder},type=bind",
    "workspaceFolder": "/anta-psirt",
    "containerUser": "avd",
    "runArgs": ["--env-file", "${localWorkspaceFolder}/labs/${containerWorkspaceFolder}/.vscode/lab_vars.public.env"]
}
